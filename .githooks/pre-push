#!/bin/sh
# Refuses a push that `make lint` fails (`make hooks` turns it on for a
# clone). Quiet when it passes; on a failure, the lint's output and how to
# push anyway.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
log=$(mktemp "${TMPDIR:-/tmp}/nushi-pre-push.XXXXXX") || exit 1
trap 'rm -f "$log"' EXIT
if ! make lint >"$log" 2>&1; then
	cat "$log" >&2
	echo "pre-push: make lint failed, so nothing was pushed (git push --no-verify skips this check)." >&2
	exit 1
fi
